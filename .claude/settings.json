{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git commit *)",
      "Bash(git push:*)",
      "Bash(git push *)"
    ]
  },
  "env": {
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  }
}
