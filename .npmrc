# Supply-chain guard: never install a version that was published less than a week ago.
# A compromised release is usually spotted and unpublished within days, so waiting one
# week out-sources that detection to everyone else. Applies when adding or updating a
# dependency; `npm ci` installs whatever package-lock.json already pins.
#
# The cost, per npm's own docs: if this window blocks a security fix, npm keeps the
# vulnerable version, warns, and exits non-zero. Exempt a package when that happens:
#   min-release-age-exclude[]=some-package
min-release-age=7
